# ==================================================
# MILA BRAND - ENVIRONMENT CONFIGURATION
# ==================================================

# PostgreSQL Database Connection URL
# Example: postgresql://postgres:password@localhost:5432/mila_db?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mila_db?schema=public"

# Telegram Bot Token from @BotFather
BOT_TOKEN="your_telegram_bot_token_here"

# Telegram Bot Username (without @)
TELEGRAM_BOT_USERNAME="mila_brand_bot"

# Public URL of the Web App (where Telegram opens the Mini App)
# In development, you can use ngrok/localtunnel URL (e.g., https://your-subdomain.ngrok-free.app)
# In production, use your deployed domain (e.g., https://mila-shop.com)
WEB_APP_URL="https://your-domain.com"

# Admin Telegram User IDs (Numbers only)
# Get your numeric ID from @userinfobot or /start in bot
ADMIN_ID_1="123456789"
ADMIN_ID_2="987654321"

# Next.js Application URL (for internal API calls)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Environment mode (development / production)
NODE_ENV="development"
